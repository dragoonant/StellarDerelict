{
  "name": "stellar-derelict",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Stellar Derelict: an original 3D corridor-tactics browser game. Armoured boarders against an alien swarm.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "validate:data": "tsx tools/validate-data.ts",
    "sim": "tsx tools/sim.ts",
    "bench:ai": "tsx tools/ai-bench.ts",
    "figures:lint": "node tools/figures/lint-prompts.mjs",
    "figures:concepts": "node tools/figures/gen-concepts.mjs",
    "figures:inputs": "node tools/figures/make-hunyuan-inputs.mjs",
    "models:optimize": "node tools/models/optimize.mjs",
    "audio:gen": "node tools/audio/gen-audio.mjs",
    "audio:measure": "node tools/audio/measure-audio.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^25.9.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
